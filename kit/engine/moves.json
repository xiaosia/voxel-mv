                   {"a": "@arms", "i": 1, "lean": 0.1}, {"a": "@arms", "i": 3, "lean": -0.1}, {"a": "@step", "i": 1, "spin": true}, {"a": "@pose", "i": -1, "sq": 1.0}]}
